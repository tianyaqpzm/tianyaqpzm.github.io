{
    "go.inferGopath": false,
    "java.checkstyle.configuration": "./source/_posts/other/google_checks.xml",
    "java.errors.incompleteClasspath.severity": "info",
    "java.project.sourcePaths": [
        "source/_posts/Algorithm/经典算法/排序",
        "source/_posts/Algorithm/算法专题/回溯",
        "source/_posts/Algorithm/算法专题/动态规划/回文子串",
        "source/_posts/Algorithm/数据结构/堆",
        "source/_posts/Algorithm/数据结构/基本用法",
        "source/_posts/Algorithm/数据结构/二叉树/二叉搜索树",
        "source/_posts/Algorithm/数据结构/二叉树",
        "source/_posts/Algorithm/基本用法/Java/1.0输入输出",
        "source/_posts/Algorithm/1.leetcode/java_demo/src/test/java/com/pei/algorithm",
        "source/_posts/1.leetcode/tmp",
        "source/_posts/Algorithm/算法专题/动态规划"
    ],
    "java.debug.settings.onBuildFailureProceed": true,
    "java.project.referencedLibraries": [
        "lib/**/*.jar",
        "/Users/pei/blog/blog/lib/**/*.jar"
    ],
    // 使用轻量级Jest Runner ，而没有使用Jest插件
    "jest.jestCommandLine": "npm test",
    "jest.autoRun": {
        "watch": false,
        "onSave": "test-file"
    },
    "jest.showCoverageOnLoad": true,
    "jest.coverageFormatter": "DefaultFormatter",
    "kiroAgent.configureMCP": "Disabled",
    "python.defaultInterpreterPath": "/Users/pei/.pyenv/versions/py-demo/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "source/_posts/Algorithm/1.leetcode/py-demo/tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.analysis.extraPaths": [
        "./source/_posts/Algorithm/1.leetcode/py-demo/src"
    ]
}
